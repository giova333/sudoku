# ---- Unity generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data — only ignore metas for ignored folders
!/[Aa]ssets/**/*.meta

# ---- IDE / tooling ----
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
*.csproj
# ...but the standalone runner projects under tools/ are hand-written and
# must be checked in, or a fresh clone cannot run tools/check.sh.
!/tools/**/*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Build artifacts ----
sysinfo.txt
*.apk
*.aab
*.ipa
*.unitypackage
*.app
crashlytics-build.properties

# ---- Addressables / Burst (future) ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- standalone core test runner (dev tooling) ----
**/bin/
**/obj/
tools/**/TestResults/
TestResults.xml
