<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Command-line front end for BankBaker, so banks can be produced without
    opening the editor (and so CI can rebuild them). The Unity menu item in
    Sudoku.Editor calls exactly the same Core code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Sudoku.Bake</AssemblyName>
    <RootNamespace>Sudoku.Bake</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sudoku.Core.Build/Sudoku.Core.Build.csproj" />
  </ItemGroup>
</Project>
